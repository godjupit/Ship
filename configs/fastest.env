# Frozen 200-image preset (five-run median 0.161119 s); caller overrides take precedence.
# Full validation AP50: 0.905387 versus baseline 0.917040. The 512/q100
# engine scored 0.892285, below 98% of baseline on this local validation set.
export BACKEND="${BACKEND:-tensorrt}"
if [[ "$BACKEND" == "tensorrt" ]]; then
  export INPUT_SIZE="${INPUT_SIZE:-544}"
  export TRT_ENGINE="${TRT_ENGINE:-weights/supership-544.engine}"
  export TRT_STANDALONE="${TRT_STANDALONE:-1}"
  # The standalone NumPy postprocessor does not use BLAS. Avoid idle worker
  # threads and their teardown overhead; preserve explicit caller settings.
  export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
else
  export INPUT_SIZE="${INPUT_SIZE:-544}"
fi
export PIPELINE="${PIPELINE:-fast}"
export PRECISION="${PRECISION:-fp16}"
export BATCH_SIZE="${BATCH_SIZE:-8}"
# Six decoders were faster on the verified eight-CPU Slurm allocation, leaving
# room for CUDA submission and JSON formatting. Use nine on the measured 10-CPU host and honor
# caller overrides, including the historical preset's explicit ten workers.
if [[ "${SLURM_CPUS_PER_TASK:-}" == "8" ]]; then
  export NUM_WORKERS="${NUM_WORKERS:-6}"
else
  export NUM_WORKERS="${NUM_WORKERS:-9}"
fi
export PIPELINE_DEPTH="${PIPELINE_DEPTH:-3}"
export SCORE_THRESHOLD="${SCORE_THRESHOLD:-0.05}"
export IMAGE_DECODER="${IMAGE_DECODER:-opencv}"
export VECTORIZED_RESULTS="${VECTORIZED_RESULTS:-1}"
export CHANNELS_LAST="${CHANNELS_LAST:-1}"
export MODEL_DEPLOY="${MODEL_DEPLOY:-0}"
export FAST_EXIT="${FAST_EXIT:-1}"
export TORCH_THREADS="${TORCH_THREADS:-1}"
export JPEG_REDUCTION="${JPEG_REDUCTION:-2}"
export RESIZE_ANTIALIAS="${RESIZE_ANTIALIAS:-1}"
if [[ "$BACKEND" == "tensorrt" ]]; then
  export OPENCV_COPY_MODE="${OPENCV_COPY_MODE:-rgb}"
else
  export OPENCV_COPY_MODE="${OPENCV_COPY_MODE:-cvtcolor}"
fi
export ASYNC_OUTPUT="${ASYNC_OUTPUT:-1}"
export DECODER_LAYERS="${DECODER_LAYERS:-0}"
export CUDNN_BENCHMARK="${CUDNN_BENCHMARK:-0}"
export FUSE_CONV_BN="${FUSE_CONV_BN:-1}"
export KERNEL_WEIGHT_HALF="${KERNEL_WEIGHT_HALF:-1}"
export KERNEL_AFFINE_HALF="${KERNEL_AFFINE_HALF:-0}"
export KERNEL_ENCODER_LAYOUT="${KERNEL_ENCODER_LAYOUT:-0}"
export KERNEL_LINEAR1X1="${KERNEL_LINEAR1X1:-1}"
export FEATURE_CAT="${FEATURE_CAT:-triton_half}"
export EARLY_INPUT_RECYCLE="${EARLY_INPUT_RECYCLE:-1}"
export BULK_RESULTS="${BULK_RESULTS:-1}"
export DEFORM_ATTN_IMPL="${DEFORM_ATTN_IMPL:-triton}"
export CUDA_DEVICE_MAX_CONNECTIONS="${CUDA_DEVICE_MAX_CONNECTIONS:-1}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-backend:native}"
export DEFORM_VALUE_CACHE="${DEFORM_VALUE_CACHE:-0}"
export HOST_THP="${HOST_THP:-1}"
export KERNEL_RELU_AFFINE_FUSE="${KERNEL_RELU_AFFINE_FUSE:-1}"
export KERNEL_RELU_AFFINE_HALF_OUT="${KERNEL_RELU_AFFINE_HALF_OUT:-1}"
export THREADED_JSON="${THREADED_JSON:-1}"
export POST_TOP_QUERIES="${POST_TOP_QUERIES:-100}"
export INFERENCE_IMPORTS="${INFERENCE_IMPORTS:-1}"
